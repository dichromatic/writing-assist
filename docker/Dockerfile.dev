FROM python:3.12-slim-bookworm

ARG NODE_MAJOR=22

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        build-essential \
    && curl -fsSL https://deb.nodesource.com/setup_${NODE_MAJOR}.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Download NLTK corpora needed by the NLP pipeline into a system-wide path
# so every Python environment in the container finds them. This runs during
# image build (network available) so the corpora are baked in and no
# runtime download is attempted against a network that may not be reachable.
RUN uv pip install --system --no-cache nltk \
    && python -m nltk.downloader -d /usr/local/share/nltk_data \
        stopwords wordnet omw-1.4

WORKDIR /workspace
